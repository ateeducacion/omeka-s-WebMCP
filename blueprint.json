{
  "$schema": "https://omeka-s-contrib.github.io/omeka-s-blueprints/schema/v0/blueprint-schema.json",
  "install": {
    "title": "WebMCP Playground",
    "locale": "es",
    "timezone": "Atlantic/Canary"
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "password": "password",
      "role": "global_admin"
    }
  ],
  "modules": [
    {
      "name": "WebMCP",
      "state": "activate",
      "source": "https://github.com/ateeducacion/omeka-s-WebMCP/archive/refs/heads/main.zip"
    }
  ],
  "sites": [
    {
      "title": "WebMCP Demo",
      "slug": "demo",
      "theme": "default",
      "summary": "Instalacion minima para probar el modulo WebMCP en Omeka S Playground.",
      "isPublic": true,
      "setAsDefault": true
    }
  ],
  "x-playground": {
    "debug": {
      "enabled": true
    },
    "landingPage": "/admin"
  }
}
